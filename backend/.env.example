# Swati Soaps Backend Configuration
# Copy this file to .env and fill in your values

# Anthropic API Key for generating marketing benefit statements
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Database path (defaults to swati_soaps.db)
# DATABASE_PATH=swati_soaps.db

# Optional: JWT Secret (change in production)
# JWT_SECRET_KEY=your-secret-key
