        # Check for duplicate name
        cursor.execute('SELECT id FROM formulations WHERE product_name = ?', (new_name,))
        if cursor.fetchone():
            conn.close()
            return jsonify({'error': 'Product name already exists'}), 400
        
        # Insert new formulation
        cursor.execute('''
